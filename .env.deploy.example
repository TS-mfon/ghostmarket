# 🔐 Deployment Credentials
# Fill in your credentials below, then run: ./scripts/deploy-all.sh

# ============================================
# GITHUB (Required for pushing code)
# ============================================
GITHUB_USERNAME=
GITHUB_TOKEN=
# Get token from: https://github.com/settings/tokens
# Needs: repo, workflow permissions

# ============================================
# GENLAYER WALLET (Required for contract deployment)
# ============================================
GENLAYER_WALLET_ADDRESS=
GENLAYER_PRIVATE_KEY=
# Your GenLayer wallet address and private key
# Make sure wallet has testnet tokens: https://faucet.genlayer.com

# ============================================
# VERCEL (Required for frontend deployment)
# ============================================
VERCEL_TOKEN=
# Get token from: https://vercel.com/account/tokens

# ============================================
# VPS (Required for backend deployment)
# ============================================
VPS_HOST=
VPS_USER=
VPS_PASSWORD=
# Your VPS IP, username, and password

# ============================================
# CRYPTORANK API (Required for trend data)
# ============================================
CRYPTORANK_API_KEY=
# Get from: https://cryptorank.io/api
# Free tier available

# ============================================
# OPTIONAL: External Services
# ============================================
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
# Get from: https://onesignal.com

# ============================================
# DATABASE (Auto-configured on VPS)
# ============================================
POSTGRES_PASSWORD=
# Strong password for PostgreSQL (will be auto-generated if empty)
