# 🔐 Deployment Credentials
# Fill in your credentials below, then run: ./scripts/deploy-all.sh

# ============================================
# GITHUB (Required for pushing code)
# ============================================
GITHUB_USERNAME=
GITHUB_TOKEN=
# Get token from: https://github.com/settings/tokens
# Needs: repo, workflow permissions

# ============================================
# GENLAYER (Required for contract deployment)
# ============================================
GENLAYER_PRIVATE_KEY=
# Your GenLayer wallet private key
# Get from: genlayer account export

# ============================================
# VERCEL (Required for frontend deployment)
# ============================================
VERCEL_TOKEN=
# Get token from: https://vercel.com/account/tokens
# Or run: vercel login (will use interactive auth)

# ============================================
# OPTIONAL: Backend Deployment
# ============================================
# Leave empty to skip backend deployment

# Option A: Railway
RAILWAY_TOKEN=
# Get from: https://railway.app/account/tokens

# Option B: Render
RENDER_API_KEY=
# Get from: https://dashboard.render.com/u/settings#api-keys

# Option C: VPS
VPS_HOST=
VPS_USER=
VPS_SSH_KEY_PATH=
# Path to your SSH private key

# ============================================
# OPTIONAL: External Services
# ============================================
COINGECKO_API_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
